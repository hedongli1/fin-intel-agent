# ============================================================
#  fin-intel-agent 环境变量配置示例
#  复制为 .env 后按需填写：cp .env.example .env
#
#  优先级：环境变量(.env) > 配置文件(config/config.yaml)
#  .env 中留空或整行注释掉的变量,自动回退到 config.yaml 的默认值。
# ============================================================

# ── 【必填】飞书群机器人 webhook ─────────────────────────────
# 获取：建飞书群 -> 群设置 -> 群机器人 -> 自定义机器人 -> 复制 webhook 地址(形如
#        https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx)
# 留空 = dry-run,报告只打印到控制台、不推送飞书。
FEISHU_WEBHOOK_URL=

# ── 动态排行榜监控池(可选；整行注释则沿用 config.yaml 默认「五榜各取前20、池上限100」)──
# RANK_BY_LIST 参与取池的榜单口径列表(英文逗号分隔,顺序即榜单展示顺序)：
#   成交额 / 涨幅 / 换手率 / 量比 / 总市值
RANK_BY_LIST=成交额,涨幅,换手率,量比,总市值
# TOP_N 每榜前 N 名(默认 20)
TOP_N=20
# MAX_POOL_SIZE 五榜并集去重后监控池上限(默认 100)
MAX_POOL_SIZE=100
# ALERT_PCT 异动阈值(%):|涨跌幅| >= 该值标记异动并附新闻(默认 9.0)
ALERT_PCT=9.0

# ── 以下变量均可整行注释掉,沿用 config.yaml 默认值 ──────

# 盘前/盘后报告 cron(五段式:分 时 日 月 周);盘中实时可调密,如 */10 9-15 * * 1-5
# PREMARKET_CRON=30 9 * * 1-5
# AFTERMARKET_CRON=30 15 * * 1-5

# 运行模式:true/1 = 只打印不推送;false/0 = 正式推送飞书
# DRY_RUN=true

# 日志级别:DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
